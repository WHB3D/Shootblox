{
  "name": "shootblox",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Packages": {
        "$path": "Packages"
      },
      "DevPackages": {
        "$path": "DevPackages"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CameraMode": "LockFirstPerson"
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [0.4, 0.42, 0.5],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "OutdoorAmbient": [0.65, 0.7, 0.8],
        "ClockTime": 14,
        "Technology": "Future"
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}